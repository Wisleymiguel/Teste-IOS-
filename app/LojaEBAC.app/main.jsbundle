              MOBILE: 1,
              FIXED_LINE_OR_MOBILE: 2,
              TOLL_FREE: 3,
              PREMIUM_RATE: 4,
              SHARED_COST: 5,
              VOIP: 6,
              PERSONAL_NUMBER: 7,
              PAGER: 8,
              UAN: 9,
              VOICEMAIL: 10,
              UNKNOWN: -1
